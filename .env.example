# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi nilai sebenarnya.

DJANGO_SECRET_KEY=ganti-dengan-string-acak
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Kosongkan untuk memakai SQLite (pengembangan)
# Contoh MySQL: mysql://user:password@127.0.0.1:3306/sikuliah
DATABASE_URL=

MAX_UPLOAD_SIZE_MB=5

# Kata sandi akun demo (jangan di-commit). Kosong = dibuat acak saat seed.
DEMO_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_DOSEN_PASSWORD=
DEMO_MAHASISWA_PASSWORD=
FORCE_DEMO_PASSWORD=False

# --- Object storage (opsional; Supabase/B2/R2) ---
# Biarkan False untuk menyimpan berkas di media/ lokal.
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
